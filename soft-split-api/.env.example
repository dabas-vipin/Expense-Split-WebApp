# Soft Split API — copy this file to `.env` and fill in real values.

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=expense_sharing
DB_SSL=false

# Auth
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_SECRET=change_me_to_a_long_random_string

# Runtime
PORT=7000
NODE_ENV=development

# CORS allowlist (comma-separated origins). Defaults to http://localhost:3000.
# Production deployments MUST set this explicitly to the frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Where uploaded avatars (and other user-uploaded files) live. Defaults to
# `./uploads` relative to the API process working directory.
UPLOADS_DIR=

# Base URL the frontend is served from. Used to construct the link emailed
# in password-reset requests. Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000
